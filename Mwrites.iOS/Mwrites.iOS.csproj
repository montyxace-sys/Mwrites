<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-ios</TargetFramework>
    <SupportedOSPlatformVersion>17.4</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>Mwrites.iOS</RootNamespace>
    <AssemblyName>Mwrites.Portable.iOS</AssemblyName>
    <ApplicationDisplayVersion>1.1</ApplicationDisplayVersion>
    <ApplicationVersion>1</ApplicationVersion>
    <BundleIdentifier>com.msoft.mwrites</BundleIdentifier>
    <CodesignEntitlements>Entitlements.plist</CodesignEntitlements>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.iOS" Version="11.3.23" />
    <ProjectReference Include="..\Mwrites.Portable.App\Mwrites.Portable.App.csproj" />
  </ItemGroup>

</Project>
