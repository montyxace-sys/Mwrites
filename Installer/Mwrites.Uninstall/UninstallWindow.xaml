<Window x:Class="Mwrites.Uninstall.UninstallWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Desinstalar Mwrites"
        Width="680" Height="560"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="True"
        FontFamily="Segoe UI" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display"
        SnapsToDevicePixels="True">

    <Border CornerRadius="14" Background="#FFFFFF" Margin="20">
        <Border.Effect>
            <DropShadowEffect BlurRadius="34" ShadowDepth="0" Opacity="0.3" Color="#0B1220"/>
        </Border.Effect>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="140"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="82"/>
            </Grid.RowDefinitions>

            <!-- Cabecera -->
            <Border Grid.Row="0" CornerRadius="14,14,0,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#0B1220" Offset="0"/>
                        <GradientStop Color="#1E293B" Offset="1"/>
                    </LinearGradientBrush>
                </Border.Background>
                <Grid>
                    <Border Height="4" VerticalAlignment="Bottom" Background="{StaticResource AccentBrush}"/>
                    <Grid Margin="34,26,22,22">
                        <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                                HorizontalAlignment="Right" VerticalAlignment="Top" Click="BtnClose_Click"/>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Border Width="62" Height="62" CornerRadius="14" Background="#16233A"
                                    VerticalAlignment="Top" Margin="0,2,18,0">
                                <Image Source="Assets/icon.png" Width="42" Height="42"/>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="Desinstalar Mwrites" FontSize="26" FontWeight="Bold"
                                           Foreground="#FFFFFF"/>
                                <TextBlock Text="Se quitará Mwrites de este equipo"
                                           FontSize="13" Foreground="#94A3B8" Margin="0,5,0,0"/>
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- Contenido -->
            <Border Grid.Row="1" Padding="34,24,34,12">
                <StackPanel>
                    <Border Background="#FFF7ED" CornerRadius="10" Padding="16,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="20"
                                       Foreground="#B45309" VerticalAlignment="Top" Margin="0,1,12,0"/>
                            <TextBlock Grid.Column="1" TextWrapping="Wrap" FontSize="12.5" Foreground="#92400E"
                                       LineHeight="19"
                                       Text="Se eliminarán Mwrites, sus accesos directos y su entrada en Aplicaciones instaladas. Tus documentos no se tocan."/>
                        </Grid>
                    </Border>

                    <TextBlock Text="CARPETA DE INSTALACIÓN" Style="{StaticResource SectionLabel}"
                               Margin="0,22,0,8"/>
                    <Border Background="{StaticResource FieldBrush}" BorderBrush="{StaticResource LineBrush}"
                            BorderThickness="1" CornerRadius="8" Padding="12,10">
                        <TextBlock x:Name="txtPath" FontSize="12.5" Foreground="{StaticResource InkBrush}"
                                   TextTrimming="CharacterEllipsis"/>
                    </Border>

                    <TextBlock Text="Si Mwrites está abierto, ciérralo antes de continuar."
                               FontSize="11.5" Foreground="{StaticResource MutedBrush}" Margin="0,16,0,0"/>
                </StackPanel>
            </Border>

            <!-- Pie -->
            <Border Grid.Row="2" Padding="34,0,28,0"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="0,1,0,0">
                <Grid>
                    <TextBlock Text="Esta acción no se puede deshacer." FontSize="11.5"
                               Foreground="{StaticResource SoftMutedBrush}" VerticalAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button x:Name="btnCancel" Style="{StaticResource SecondaryButton}" Content="Cancelar"
                                Margin="0,0,10,0" Click="BtnCancel_Click"/>
                        <Button x:Name="btnUninstall" Style="{StaticResource PrimaryButton}" Content="Desinstalar"
                                Click="BtnUninstall_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Progreso -->
            <Border x:Name="ProgressView" Grid.RowSpan="3" Background="#FFFFFF" CornerRadius="14"
                    Visibility="Collapsed">
                <Grid>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;" IsEnabled="False"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"/>
                    <StackPanel Width="440" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="Desinstalando Mwrites" FontSize="24" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"/>
                        <TextBlock x:Name="txtPercent" Text="0 %" FontSize="52" FontWeight="Bold"
                                   Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center"
                                   Margin="0,16,0,12"/>
                        <ProgressBar x:Name="Bar" Style="{StaticResource ModernProgress}"
                                     Minimum="0" Maximum="100" Value="0" Height="10"/>
                        <TextBlock x:Name="txtProgressStatus" Text="Preparando la desinstalación…"
                                   FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,16,0,0"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Completado -->
            <Border x:Name="DoneView" Grid.RowSpan="3" Background="#FFFFFF" CornerRadius="14"
                    Visibility="Collapsed">
                <Grid>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"
                            Click="BtnDoneClose_Click"/>
                    <StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse Fill="{StaticResource SuccessSoftBrush}"/>
                            <Ellipse Width="64" Height="64" Fill="{StaticResource SuccessBrush}"/>
                            <TextBlock Text="&#xE73E;" FontFamily="Segoe MDL2 Assets" FontSize="30"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="Desinstalación completada" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"
                                   Margin="0,20,0,0"/>
                        <TextBlock Text="Mwrites se ha quitado de este equipo."
                                   FontSize="13.5" Foreground="{StaticResource MutedBrush}"
                                   HorizontalAlignment="Center" Margin="0,7,0,0"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Cerrar"
                                HorizontalAlignment="Center" Margin="0,28,0,0" Click="BtnDoneClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Error -->
            <Border x:Name="ErrorView" Grid.RowSpan="3" Background="#FFFFFF" CornerRadius="14"
                    Visibility="Collapsed">
                <Grid>
                    <Button Style="{StaticResource CloseButton}" Content="&#xE8BB;"
                            HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,18,18,0"
                            Click="BtnDoneClose_Click"/>
                    <StackPanel Width="460" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid Width="84" Height="84" HorizontalAlignment="Center">
                            <Ellipse Fill="{StaticResource DangerSoftBrush}"/>
                            <Ellipse Width="64" Height="64" Fill="{StaticResource DangerBrush}"/>
                            <TextBlock Text="&#xE7BA;" FontFamily="Segoe MDL2 Assets" FontSize="28"
                                       Foreground="#FFFFFF" HorizontalAlignment="Center"
                                       VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="No se pudo desinstalar" FontSize="24" FontWeight="Bold"
                                   Foreground="{StaticResource InkBrush}" HorizontalAlignment="Center"
                                   Margin="0,18,0,0"/>
                        <TextBlock x:Name="txtError" FontSize="13" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" TextAlignment="Center" Margin="0,10,0,0"
                                   LineHeight="20"/>
                        <Button Style="{StaticResource PrimaryButton}" Content="Cerrar"
                                HorizontalAlignment="Center" Margin="0,26,0,0" Click="BtnDoneClose_Click"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</Window>
