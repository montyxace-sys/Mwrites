<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>x64</PlatformTarget>
    <RootNamespace>Mwrites.Uninstall</RootNamespace>
    <AssemblyName>Mwrites.Uninstall</AssemblyName>
    <Version>0.1.0</Version>
    <Product>Mwrites</Product>
    <Company>MSoft</Company>
    <AssemblyTitle>Desinstalador de Mwrites</AssemblyTitle>
    <Description>Desinstalador de Mwrites</Description>
    <ApplicationManifest Condition="'$(Configuration)' == 'Debug'">app.dev.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' != 'Debug'">app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\App\Assets\icon.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="All" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
  </ItemGroup>

  <ItemGroup>
    <!-- El núcleo se compila dentro del desinstalador para que sea un único archivo. -->
    <Compile Include="..\Mwrites.Installer.Core\*.cs" Link="Core\%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <Page Include="..\Shared\UiTheme.xaml" Link="UiTheme.xaml" />
    <Resource Include="..\..\App\Assets\icon.png" Link="Assets\icon.png" />
  </ItemGroup>

</Project>
