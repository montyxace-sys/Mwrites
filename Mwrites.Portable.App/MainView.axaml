<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Mwrites.Portable.App.MainView">
  <DockPanel>

    <Border DockPanel.Dock="Top" Background="#F6821F" Padding="10,8">
      <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
        <Button Content="Nuevo" Click="OnNew" Background="#FFFFFF" Foreground="#1D1F20" />
        <Button Content="Abrir…" Click="OnOpen" Background="#FFFFFF" Foreground="#1D1F20" />
        <Button Content="Guardar" Click="OnSave" Background="#FFFFFF" Foreground="#1D1F20" />
        <Button Content="Guardar como…" Click="OnSaveAs" Background="#FFFFFF" Foreground="#1D1F20" />
        <Border Width="1" Height="24" Background="#FFFFFF" Opacity="0.6" Margin="4,0" />
        <TextBlock Text="Aa" VerticalAlignment="Center" Foreground="White" FontWeight="SemiBold" />
        <Button Content="MAYÚS" Click="OnUpper" Background="#FAAD3F" Foreground="#1D1F20" />
        <Button Content="minús" Click="OnLower" Background="#FAAD3F" Foreground="#1D1F20" />
        <Button Content="Iniciales" Click="OnTitle" Background="#FAAD3F" Foreground="#1D1F20" />
        <Button Content="Frase" Click="OnSentence" Background="#FAAD3F" Foreground="#1D1F20" />
      </StackPanel>
    </Border>

    <Border DockPanel.Dock="Bottom" Background="#F7F7F7" BorderBrush="#EDEDED" BorderThickness="0,1,0,0" Padding="12,7">
      <TextBlock x:Name="StatusText" FontSize="12" Foreground="#1D1F20" Text="Listo." />
    </Border>

    <TextBox x:Name="Editor"
             AcceptsReturn="True"
             TextWrapping="NoWrap"
             FontFamily="Consolas, DejaVu Sans Mono, monospace"
             FontSize="14"
             BorderThickness="0"
             Padding="22,18"
             TextChanged="OnTextChanged" />

  </DockPanel>
</UserControl>
