<Window x:Class="Mwrites.Dialogs.FindReplaceDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Buscar y reemplazar" Width="540" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="{StaticResource UiFont}">
    <Grid Margin="22,20,22,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Buscar:" />
            <TextBox x:Name="SearchBox" Grid.Column="1" Style="{StaticResource DialogTextBox}" />
        </Grid>

        <Grid Grid.Row="1" Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBlock Style="{StaticResource FieldLabel}" Text="Reemplazar por:" />
            <TextBox x:Name="ReplaceBox" Grid.Column="1" Style="{StaticResource DialogTextBox}" />
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="110,12,0,0">
            <CheckBox x:Name="MatchCaseCheck" Style="{StaticResource DialogCheckBox}" Content="Coincidir mayúsculas" Margin="0,0,18,0" />
            <CheckBox x:Name="WholeWordCheck" Style="{StaticResource DialogCheckBox}" Content="Solo palabras completas" />
        </StackPanel>

        <TextBlock x:Name="StatusText" Grid.Row="3" Margin="110,10,0,0" FontSize="12" Foreground="{StaticResource TextSecondaryBrush}" Text="" />

        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Style="{StaticResource SecondaryButton}" Content="Buscar siguiente" Click="OnFindNext" Margin="0,0,8,0" />
            <Button Style="{StaticResource SecondaryButton}" Content="Reemplazar" Click="OnReplace" Margin="0,0,8,0" />
            <Button Style="{StaticResource SecondaryButton}" Content="Reemplazar todo" Click="OnReplaceAll" Margin="0,0,8,0" />
            <Button Style="{StaticResource PrimaryButton}" Content="Cerrar" IsCancel="True" Click="OnClose" />
        </StackPanel>
    </Grid>
</Window>
