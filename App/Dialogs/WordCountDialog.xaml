<Window x:Class="Mwrites.Dialogs.WordCountDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Recuento de palabras" Width="420" SizeToContent="Height"
        ResizeMode="NoResize" ShowInTaskbar="False" WindowStartupLocation="CenterOwner"
        Background="White" FontFamily="{StaticResource UiFont}">
    <Grid Margin="24,20,24,18">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Text="Estadísticas del documento" FontSize="17" FontWeight="SemiBold"
                   Foreground="{StaticResource TextPrimaryBrush}" Margin="0,0,0,14" />

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0" Text="Páginas" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,12,8" />
            <TextBlock Grid.Row="0" Grid.Column="1" x:Name="PagesValue" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Grid.Row="1" Text="Palabras" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,12,8" />
            <TextBlock Grid.Row="1" Grid.Column="1" x:Name="WordsValue" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Grid.Row="2" Text="Caracteres (con espacios)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,12,8" />
            <TextBlock Grid.Row="2" Grid.Column="1" x:Name="CharactersValue" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Grid.Row="3" Text="Caracteres (sin espacios)" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,12,8" />
            <TextBlock Grid.Row="3" Grid.Column="1" x:Name="CharactersNoSpacesValue" FontSize="12.5" FontWeight="SemiBold" Margin="0,0,0,8" />
            <TextBlock Grid.Row="4" Text="Párrafos" Foreground="{StaticResource TextSecondaryBrush}" FontSize="12.5" Margin="0,0,12,0" />
            <TextBlock Grid.Row="4" Grid.Column="1" x:Name="ParagraphsValue" FontSize="12.5" FontWeight="SemiBold" />
        </Grid>

        <Border x:Name="SelectionCard" Grid.Row="2" Background="#F3F7FC" BorderBrush="#C9DCF2" BorderThickness="1"
                CornerRadius="4" Padding="14" Margin="0,16,0,0" Visibility="Collapsed">
            <StackPanel>
                <TextBlock Text="Selección" FontSize="13" FontWeight="SemiBold" Foreground="{StaticResource AccentBrush}" Margin="0,0,0,6" />
                <TextBlock x:Name="SelectionSummary" FontSize="12.5" Foreground="{StaticResource TextPrimaryBrush}" />
            </StackPanel>
        </Border>

        <Button Grid.Row="3" Style="{StaticResource PrimaryButton}" Content="Cerrar" IsCancel="True"
                HorizontalAlignment="Right" Margin="0,18,0,0" IsDefault="True" Click="OnClose" />
    </Grid>
</Window>
